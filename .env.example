# --- Server ---
PORT=3002

# --- Database ---
# This service owns its tables and reads HDS data over the public HTTP API, never
# by SQL — so it has NO dependency on the HDS database's own tables. Point this
# at its own Postgres, or share the HDS one; both work. `npm run migrate` creates
# orders_to_enrich, order_enrichments and loop_subscription_deliveries.
DATABASE_URL=postgres://postgres:PASSWORD@postgres.railway.app:5432/railway
# Set to "true" only if your DB requires SSL without a CA (Railway usually does).
DATABASE_SSL=true

# --- Shopify ---
SHOPIFY_STORE=staging-workoutmeals.myshopify.com
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# --- HDS public API (source of truth for enrichment) ---
HDS_API_BASE=https://hds-delivery-admin-backend-production.up.railway.app

# --- Queue processor ---
ENRICH_INTERVAL_MS=10000
ENRICH_BATCH_SIZE=10
ENRICH_MAX_ATTEMPTS=5

# --- Optional: push enriched data back onto the Shopify order as a metafield ---
SYNC_TO_SHOPIFY=false

# --- Loop Subscriptions ---
# Admin API. Custom attributes live on the SUBSCRIPTION, so we overwrite the
# delivery date before each charge (on the order/upcoming webhook).
LOOP_API_BASE=https://api.loopsubscriptions.com/admin/2023-10
LOOP_API_TOKEN=
# Loop documents 5 req/s per endpoint; 250ms between calls stays under it.
LOOP_API_MIN_GAP_MS=250

# Inbound order/upcoming webhook. Loop have NOT yet confirmed their signing
# scheme — set LOOP_WEBHOOK_VERIFY=false to accept unsigned calls until they do,
# then set the secret and switch verification back on.
LOOP_WEBHOOK_VERIFY=true
LOOP_WEBHOOK_SECRET=
LOOP_WEBHOOK_HEADER=X-Loop-Hmac-Sha256
LOOP_WEBHOOK_DIGEST=base64

# Shopify's app_id for Loop, used to identify renewal orders. Read it off a
# known renewal order's orders/create payload.
LOOP_SHOPIFY_APP_ID=

# Days after the charge date before the earliest acceptable delivery. 0 = the
# charge date itself is eligible.
LOOP_DELIVERY_LEAD_DAYS=0

# --- Renewal date rewrite (replaces Arigato Automation) ---
# Loop copies the SUBSCRIPTION custom attributes onto every renewal order, so a
# renewal arrives carrying the first cycle delivery/pack/production dates. When
# a renewal Delivery-Date predates the order itself, we recompute from the order
# date and write the result back onto the order (Delivery-Date, Pick-Pack-Date,
# the HDS * set, and a Pick-Pack-Date-DD-MM-YYYY tag).
#
# Requires SHOPIFY_ADMIN_TOKEN with write_orders. Set to false to stand this
# down without a deploy - e.g. while Arigato is still live, so the two do not
# both write to the same order.
REWRITE_RENEWAL_DATES=true

# Loop publishes an order id before the subscription behind it is writable, so
# both the lookup and the chargeOffset write retry across that lag.
LOOP_LOOKUP_RETRIES=4
LOOP_LOOKUP_BACKOFF_MS=3000

# Delivery-Time is a clock range on the order, but HDS only knows window NAMES
# ("AM", "Business Hours") - the range lives in the checkout extension, so the
# mapping is configuration rather than something to infer. Set this and the
# rewrite keeps Delivery-Time in step with the window it wrote; leave it unset
# and the order keeps whatever Delivery-Time it already carries.
#
# The values below are what the staging and production orders were observed
# carrying - CONFIRM them against the checkout extension before enabling, since
# a wrong range is customer-visible.
# These are the ranges the HDS region config itself defines, so they are the values
# to use once HDS owns scheduling. While another app still writes Delivery-Time,
# leave this UNSET and the order keeps whatever that app put there.
# DELIVERY_WINDOW_TIMES={"AM":"12:00 AM - 7:00 AM","Business Hours":"8:00 AM - 6:00 PM"}
#
# Delivery-Time holds the clock range and NOTHING else - "8:00 AM - 6:00 PM" -
# which is the form it has always had and the form whatever reads it downstream
# expects. The line above is all most setups need.
#
# A window may also record the NAME the customer saw. That name is NOT written
# into Delivery-Time; it is kept so anything that wants to name the window need
# not re-derive it from a pair of times. 'name'/'range' work as well as
# 'label'/'time'.
# DELIVERY_WINDOW_TIMES={"AM":{"label":"Morning","time":"12:00 AM - 7:00 AM"},"Business Hours":{"label":"Daytime","time":"8:00 AM - 6:00 PM"}}
#
# Defaults to "{time}", so the value stays numeric. Set this only to opt the
# label IN - "{label} {time}" gives "Morning 12:00 AM - 7:00 AM" - and remember
# it changes a value other systems parse.
# DELIVERY_TIME_FORMAT={time}
#
# Note how this reaches existing orders. The renewal rewrite owns Delivery-Time
# and replaces it. The fill is additive, so it ADDS a range to an order that has
# no Delivery-Time and leaves one that already has a value alone - correcting a
# wrong range needs `npm run packdates:backfill -- --recompute`.

# The hard fallback for an order that has NEVER carried a Delivery-Time at all -
# not merely one DELIVERY_WINDOW_TIMES leaves unmapped. Now that Zapiet/Arigato
# are disabled and HDS is the only source of these dates, every order (webhook,
# the periodic sweep, and packdates:backfill) gets this value the moment it is
# found missing, matching the widest schedule window HDS offers. It NEVER
# replaces a value the customer actually chose - only fills a true gap.
# Defaults to "8:00 AM - 6:00 PM" - set this only to change that default.
# DELIVERY_TIME_DEFAULT=8:00 AM - 6:00 PM

# Weekday-arithmetic fallback: next occurrence of the customer delivery weekday
# on or after the order date, pack/production carried forward at the same gaps
# as their previous cycle, cutoff derived from Charge Offset.
#
# OFF by default on purpose. HDS omits options whose production cutoff has
# already passed and this does not - asked for a Friday on 2026-08-19 it returns
# 2026-08-21, whose Tuesday cutoff was already gone, where HDS correctly answers
# 2026-08-28. So it can promise the kitchen something it cannot make. Only worth
# enabling for weekdays HDS has no schedule for at all.
FALLBACK_WEEKDAY_MATH=false

# --- Shopify OAuth (Dev Dashboard apps) ---
# Shopify retired legacy custom apps for this org, so the store admin no longer
# offers a reveal-once Admin API token. A Dev Dashboard app exposes only a Client
# ID and Secret, and issues its access token during install - so the app has to
# receive one. Set these, then visit APP_URL/auth?shop=<store>.myshopify.com once;
# the offline token is stored in shopify_oauth_tokens and never expires.
#
# Add APP_URL/auth/callback to the app Allowed redirection URL(s) in the Dev
# Dashboard, and run `npm run migrate` to create the table.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
APP_URL=https://hds-order-loop-enrichment-production.up.railway.app
SHOPIFY_OAUTH_SCOPES=read_orders,write_orders

# Only needed if a legacy custom-app token still exists. When set it takes
# precedence over the stored OAuth token.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxx

# --- Note-attribute label renames ---
# "HDS Pack Date" is written as "HDS Ship Date". Renewals get the new label from
# the date rewrite; a first-time checkout order is never rewritten, so the
# orders/create webhook renames it in place - value untouched, only the label.
# Set false to stop touching orders for renames alone.
RENAME_LEGACY_LABELS=true

# Gap between writes during the labels:rename backfill. Shopify allows 2 REST
# calls/second sustained, so just over 500ms avoids throttling on a long run.
SHOPIFY_WRITE_GAP_MS=550

# How to pick a renewal delivery date when the customer own weekday is not the
# soonest option available:
#
#   keep-weekday  a Monday subscriber stays on Monday even if that means waiting
#                 a week because Monday cutoff has passed
#   earliest      take the soonest date HDS offers, whatever weekday it falls on
#
# Order placed 2026-08-21 in postcode 2170, Sunday subscriber:
#   keep-weekday -> Sun 2026-08-30, pick-pack 08-29
#   earliest     -> Mon 2026-08-24, pick-pack 08-23
# Six days apart, so this is a business decision rather than a detail.
RENEWAL_DELIVERY_SELECTION=cutoff-day

#   cutoff-day (default)  the day the order was created IS the cutoff day, so use
#                         the region schedule for that cutoff, which carries its own
#                         ship and delivery days. Loop charges at the cutoff, so the
#                         charge day identifies the schedule. NSW: a Friday cutoff
#                         ships Sunday and delivers Monday. Reads the triple from
#                         HDS per SUBURB rather than a hardcoded region table, so it
#                         stays correct when a schedule changes.
#                         Uses nothing from the subscription attributes - a stale
#                         Delivery-Date can no longer decide the weekday.

# Orders scheduled by another app (Zapiet on production) arrive with a valid
# future Delivery-Date and no HDS fields at all. The rewrite rightly leaves the
# date alone, which left the kitchen with no pack or production date for them.
# This fills the HDS records in AROUND the existing delivery date: the schedule
# is matched by that date weekday for the shipping suburb, and its own pack and
# production gaps applied. Delivery-Date and Delivery-Time are never changed.
FILL_HDS_RECORDS=true

# How much that fill adds:
#
#   all-missing (default) every HDS field the order lacks
#   pack-date             Pick-Pack-Date only - the one key NetSuite reads
#
# Either way the write is ADDITIVE. A value already on the order is never
# replaced, so no date a customer was told can change. Re-running is a no-op.
FILL_HDS_ATTRIBUTES=all-missing

# Every order carries the tags the live orders used to get from Arigato and Zapiet:
# the delivery date bare ("07-09-2026")
# and the pack date prefixed ("Pick-Pack-Date-05-09-2026"). Derived from the dates
# already on the order, so no HDS call is involved and a serviceability problem
# cannot stop it. Additive - a tag already present is left alone.
#
# Arigato and Zapiet used to tag orders; nothing replaced them, which is why a
# normal checkout order was arriving with an empty Tags box.
TAG_ORDER_DATES=true

# Whether a date rewrite may clear the date tags it supersedes.
#
# Off by default: tags on an order may be there for reasons this service knows
# nothing about, so writes only ever ADD. The cost, stated plainly - an order
# whose dates are rewritten keeps its previous date tags alongside the new ones,
# so a fulfilment filter on "Pick-Pack-Date-*" would match both.
#
# HDS-Dates-Held is exempt either way: it is a marker this service sets itself,
# and leaving it on an order whose dates are now correct would mislabel it.
TAG_REMOVE_SUPERSEDED=false

# --- Retrying orders whose HDS write did not land ---
# The webhook gets one attempt. If it fails - HDS unreachable, a wrong
# HDS_API_BASE, a rejected Shopify write - nothing used to try again, and that
# order had no pack date until someone ran the backfill by hand. These rows are
# now re-attempted on a slow interval, bounded so an order HDS genuinely cannot
# serve stops consuming API calls rather than retrying forever.
#
# 5 minutes / 25 rows (was 15 minutes / 10): a Loop renewal burst can leave more
# than 10 rows behind in one go, and at the old pace a burst-sized backlog could
# still be sitting there hours later - which is what "still broken by morning"
# looks like. Both jobs share Shopify's single paced queue with the live
# webhook, so raising these adds queue depth, not risk of 429s.
HDS_RETRY_ENABLED=true
HDS_RETRY_INTERVAL_MS=300000
HDS_RETRY_BATCH=25
HDS_RETRY_MAX_ATTEMPTS=6

# --- Surviving a Loop renewal burst ---
# Loop charges dozens of subscriptions at once, so Shopify delivers a batch of
# orders/create webhooks CONCURRENTLY - twenty orders inside a minute, several in
# the same second. Each handler makes three or four Shopify writes, so unpaced
# handlers running together empty Shopify's leaky bucket (2 calls/second
# sustained, 40 deep), Shopify answers 429, and nothing retried a 429: that write
# was lost and the order silently had no pack date.
#
# Every Admin API call now goes through one queue - concurrency 1, at least
# SHOPIFY_MIN_GAP_MS apart - so a burst QUEUES instead of failing. Raise the gap
# if 429s still appear; lower it on Shopify Plus, which allows 4/second.
# 260 assumes Shopify Plus. Set this to 550 instead on standard Shopify (2/s).
SHOPIFY_MIN_GAP_MS=260
# Attempts per call before giving up. Applies to 429 and 5xx only, and honours
# Shopify's Retry-After. A 401 or 403 is never retried: it would fail identically
# every time.
SHOPIFY_MAX_ATTEMPTS=5

# --- HDS lookups under the same burst ---
# A burst asks HDS about one suburb per order, all at once, for an answer that
# changes daily at most. Answers are cached briefly, and - the part that matters
# concurrently - orders arriving for a suburb whose request is still in the air
# share that request instead of each starting another.
#
# Short on purpose: the answer contains dates, so it must not outlive the day it
# describes. Failures are never cached, so a corrected HDS_API_BASE or the end of
# an outage takes effect immediately.
HDS_CACHE_TTL_MS=60000
# Attempts on a network error or a 5xx. "Not serviceable" is a considered answer
# from HDS and is never retried.
HDS_FETCH_ATTEMPTS=3
# Every outbound call to HDS is queued through one place, at least this many ms
# apart - a burst across many DIFFERENT suburbs (the cache above only helps
# orders sharing one) goes out steadily instead of all at once, which is what
# was letting some renewal-burst orders fail even with retries: every retry's
# backoff window was spent contending with the same burst rather than waiting
# it out. Same trade Shopify's own queue already makes.
HDS_MIN_GAP_MS=300

# --- The sweep: the backstop that does not depend on the webhook ---
# The retry job can only re-attempt orders it has a ROW for. These leave no row
# at all:
#   - Shopify never delivered the webhook (it retries a while, then gives up)
#   - the HMAC did not verify, so the handler returned 401 and never ran
#   - the process restarted mid-handling - a deploy during a renewal run
#
# So this asks Shopify directly: it walks recent orders and fixes any whose HDS
# data is incomplete. Deciding that costs no API calls, so a quiet pass is one or
# two page reads. Run it by hand any time with `npm run packdates:sweep`.
SWEEP_ENABLED=true
SWEEP_INTERVAL_MS=900000
# How far back each pass looks.
SWEEP_HOURS=24
# Orders younger than this are left to the webhook, which is probably still
# handling them. Fixing them here too would double every write during a burst.
SWEEP_MIN_AGE_MINUTES=10
# A ceiling per pass: if something systemic broke, repair over several passes
# rather than spending the whole rate limit at once and starving live webhooks.
# 15 minutes / 50 rows (was 30 minutes / 25): same reasoning as the retry job
# above - a big enough renewal burst could outrun the old pace for hours.
SWEEP_MAX_FIXES=50

# --- Alert digest: email admin a periodic order status report ---
# ALWAYS sends, whether every order is fine or not - a quiet inbox should
# never have to be trusted as "no news is good news". Two sections in every
# email:
#
#   1. Every Loop subscription order since the last report, each with its own
#      line: "Order <name> = <status>" - done, missing its pack date, missing
#      OTHER HDS fields, or present-but-wrong (see src/lib/order-status.js).
#   2. Anything from a much wider historical scan that's genuinely stuck on a
#      weekday HDS has withdrawn for its suburb (checked LIVE - fetched fresh
#      from Shopify and checked against the current HDS schedule, the same
#      way stuck-schedules.js does, since a raw dump of the historical DB rows
#      produced a 268-row email that was mostly stale noise). This is why the
#      digest runs once a day rather than the sweep's tighter interval - a
#      Shopify + HDS call per candidate adds up.
#
# A genuinely persistent problem (nobody's fixed the subscription yet) is
# suppressed for ALERT_DIGEST_DEDUPE_HOURS after it first appears in an email,
# so sending several times a day - or every day the problem remains - doesn't
# repeat the identical line every single time. It resurfaces once that window
# passes, roughly once a day for something still unresolved.
#
# Optional and additive: leave SMTP_* unset and this logs what it WOULD have
# sent instead of sending anything. Run `npm run alerts:digest` any time for
# an immediate pass instead of waiting for the schedule.
ALERT_DIGEST_ENABLED=true
# Send at one or more FIXED clock times every day, in UTC (Railway's default
# timezone unless TZ is set) - comma-separated "HH:MM". E.g. for 1:05pm AND
# 5:05pm AEST (UTC+10): ALERT_DIGEST_TIMES_UTC=03:05,07:05
#
# AEST is UTC+10 and only holds outside daylight saving (roughly Apr-Oct for
# NSW/VIC; QLD never observes it) - during AEDT (UTC+11, Oct-Apr) these fixed
# UTC times land an hour later by AU east-coast clocks.
#
# Without this, the digest instead fires every ALERT_DIGEST_INTERVAL_MS
# counted from whenever the process last started, which drifts to a different
# time of day after every redeploy. Recommended: set this instead of relying
# on the interval.
# ALERT_DIGEST_TIMES_UTC=03:05,07:05
# Fallback cadence when ALERT_DIGEST_TIMES_UTC is not set - once a day,
# relative to process start rather than a fixed time. The sweep/retry logs
# are still there for anything more immediate than a daily digest either way.
ALERT_DIGEST_INTERVAL_MS=86400000
# Section 1's window on the very FIRST report ever (or after
# alert_digest_runs is cleared) - there's no previous run to measure "since
# last time" from. Every report after that automatically covers exactly the
# gap since the previous one, however long or short that turns out to be.
ALERT_DIGEST_FIRST_RUN_HOURS=24
# Section 2's CANDIDATE window - much wider than section 1's, on purpose: a
# row that exhausted its retries stops updating, so a narrow window would let
# an old, still-unfixed order quietly stop being considered at all - it's
# still checked live either way, so a wide window costs API calls, not stale
# answers.
ALERT_DIGEST_HOURS=720
# How long a stuck order is suppressed after appearing in an email, before it
# can appear again. A little under 24h on purpose: two sends a day 4h apart
# (e.g. 03:05 and 07:05 UTC) should not both report the same still-broken
# order, but the NEXT day's first send should, if it's still unresolved.
ALERT_DIGEST_DEDUPE_HOURS=20
# Cap on how many stuck orders the email body lists, so a systemic failure
# affecting hundreds of orders produces one readable email (with a count of
# the rest) rather than one enormous one.
ALERT_DIGEST_MAX_ROWS=25
#
# SMTP credentials to actually send. Any provider works (Gmail/Office365 need
# an app password, not your normal login password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=your-smtp-password-or-app-password
# ALERT_EMAIL_FROM=alerts@yourdomain.com
# Comma-separated for more than one recipient.
# ALERT_EMAIL_TO=admin@yourdomain.com
# Optional, comma-separated: gets every alert email (digest AND per-order,
# below) without appearing on the To: line - for anyone who wants visibility
# without being a named recipient.
# ALERT_EMAIL_BCC=someone@yourdomain.com

# --- Per-order status email (real-time, additive to the digest above) ---
# The digest reports on a schedule; this instead emails admin the moment EACH
# Loop order is processed by the webhook - "Order <name> = <status>", sent
# regardless of status (including a fully correct order), same reasoning as
# the digest: silence should never have to be trusted as "everything's fine".
#
# Off by default - meaningfully more email volume than the digest (one per
# Loop order, not one summary a day). Reuses the same SMTP_*/ALERT_EMAIL_*
# config above; no separate credentials needed. Test it any time with
# `npm run order:notify -- --order <id>` (or --name), which bypasses this
# flag since it IS the manual test path.
PER_ORDER_EMAIL_ENABLED=false

# --- Schema on boot ---
# db/schema.sql is idempotent (every statement is IF NOT EXISTS), so it is applied
# at startup. The webhook's queue INSERT names columns the schema adds, and a
# deploy that forgot `npm run migrate` would otherwise fail every queue write with
# "column does not exist". Set false to manage migrations by hand.
AUTO_MIGRATE=true
# How long after boot the first sweep runs. A deploy is when someone is watching
# to see whether orders are being fixed; waiting a full interval to find out
# makes that unverifiable. Safe this early because the sweep ignores orders
# younger than SWEEP_MIN_AGE_MINUTES, so it cannot collide with the webhook
# backlog a restart delivers.
SWEEP_FIRST_PASS_MS=120000
